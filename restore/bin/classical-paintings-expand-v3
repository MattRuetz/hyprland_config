TARGET_NEW = 200
PER_SEARCH_CAP = 60


def slugify(text: str) -> str:
    text = text.lower().strip()
    text = re.sub(r"[^\w\s-]", "", text)
    text = re.sub(r"[\s_]+", "-", text)
    text = re.sub(r"-+", "-", text)
    return text[:80]


def load_state() -> dict:
    if STATE_FILE.exists():
        return json.loads(STATE_FILE.read_text())
    return {"downloaded": [], "failed": []}


def save_state(state: dict):
    STATE_FILE.write_text(json.dumps(state, indent=2))


def download_image(url: str, filepath: Path) -> bool:
    try:
        resp = requests.get(url, timeout=60, stream=True)
        resp.raise_for_status()
        content_type = resp.headers.get("content-type", "")
        if "image" not in content_type and "octet" not in content_type:
            return False
        with open(filepath, "wb") as f:
            for chunk in resp.iter_content(chunk_size=8192):
                f.write(chunk)
        if filepath.stat().st_size < 50_000:
            filepath.unlink()
            return False
        return True
    except Exception as e:
        print(f"    Download error: {e}", flush=True)
        if filepath.exists():
            filepath.unlink()
        return False


def main():
    BACKGROUNDS_DIR.mkdir(parents=True, exist_ok=True)
    state = load_state()
    seen_ids = set(state["downloaded"]) | set(state["failed"])

    all_candidates = []
    candidate_set = set()

    for label, params in SEARCHES:
        print(f"Searching: {label}...", flush=True)
        data = get_json(f"{MET_BASE}/search", params=params)
        if data is None:
            print(f"  Search failed", flush=True)
            continue
        ids = data.get("objectIDs") or []
        new_ids = [oid for oid in ids if oid not in candidate_set and str(oid) not in seen_ids][:PER_SEARCH_CAP]
        for oid in new_ids:
            candidate_set.add(oid)
            all_candidates.append(oid)
        print(f"  {len(ids)} total, {len(new_ids)} new candidates", flush=True)
        time.sleep(REQUEST_SLEEP)

    print(f"\nTotal new candidates: {len(all_candidates)}")
    print(f"Target: {TARGET_NEW} new paintings\n")

    downloaded = 0
    scanned = 0
    for obj_id in all_candidates:
        if downloaded >= TARGET_NEW:
            break

        time.sleep(REQUEST_SLEEP)
        scanned += 1
        if scanned % 50 == 0:
            print(f"  ... scanned {scanned}/{len(all_candidates)}, downloaded {downloaded}", flush=True)

        obj = get_json(f"{MET_BASE}/objects/{obj_id}")
        if obj is None:
            continue

        if not obj.get("isPublicDomain"):
            continue
        if not obj.get("primaryImage"):
            continue

        medium = obj.get("medium", "").lower()
        if "oil" not in medium:
            continue

        title = obj.get("title", "untitled")
        artist = obj.get("artistDisplayName", "unknown") or "unknown"
        image_url = obj["primaryImage"]

        filename = f"met-{obj_id}-{slugify(artist)}-{slugify(title)}.jpg"
        filepath = BACKGROUNDS_DIR / filename

        if filepath.exists():
            state["downloaded"].append(str(obj_id))
            save_state(state)
            downloaded += 1
            continue

        print(f"  [{downloaded+1}/{TARGET_NEW}] {artist} - {title}", flush=True)
        if download_image(image_url, filepath):
            downloaded += 1
            state["downloaded"].append(str(obj_id))
            save_state(state)
        else:
            state["failed"].append(str(obj_id))
            save_state(state)

    total = len([f for f in BACKGROUNDS_DIR.iterdir()
                 if f.is_file() and not f.name.startswith(".")])
    print(f"\n{'='*60}")
    print(f"Added {downloaded} new paintings. Total collection: {total}")
    print(f"{'='*60}")


if __name__ == "__main__":
    main()
