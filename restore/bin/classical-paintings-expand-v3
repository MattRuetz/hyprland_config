#!/usr/bin/env python3
"""Download 200 more paintings: Americana, varied landscapes, colorful works."""

import json
import re
import sys
import time
from pathlib import Path

import requests

BACKGROUNDS_DIR = Path.home() / ".config/omarchy/themes/classical-paintings/backgrounds"
STATE_FILE = BACKGROUNDS_DIR / ".download-state.json"
MET_BASE = "https://collectionapi.metmuseum.org/public/collection/v1"

REQUEST_SLEEP = 0.5
HEADERS = {"User-Agent": "ClassicalPaintingsBot/1.0 (personal wallpaper rotation)"}


def get_json(url, params=None, max_retries=3):
    for attempt in range(max_retries):
        try:
            resp = requests.get(url, params=params, headers=HEADERS, timeout=30)
            if resp.status_code != 200:
                time.sleep(5 * (attempt + 1))
                continue
            text = resp.text.lstrip()
            if text.startswith("<"):
                print(f"  ! Rate-limited, backing off {15 * (attempt + 1)}s", flush=True)
                time.sleep(15 * (attempt + 1))
                continue
            return resp.json()
        except (requests.RequestException, json.JSONDecodeError) as e:
            print(f"  ! Request error: {e}", flush=True)
            time.sleep(5)
    return None


# Broader searches for variety: Americana, colorful, new landscapes, maritime, genre
SEARCHES = [
    # Americana — frontier, genre, folk
    ("Emanuel Leutze", {"hasImages": "true", "isPublicDomain": "true", "q": "Emanuel Leutze"}),
    ("John Singer Sargent", {"hasImages": "true", "isPublicDomain": "true", "q": "John Singer Sargent"}),
    ("Mary Cassatt", {"hasImages": "true", "isPublicDomain": "true", "q": "Mary Cassatt"}),
    ("Childe Hassam", {"hasImages": "true", "isPublicDomain": "true", "q": "Childe Hassam"}),
